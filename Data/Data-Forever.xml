<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- Forever's payloads (ns.data.*), loaded on that client instead of
         Data.xml. Each file assigns the same keys as its retail sibling; a
         Forever export replaces its file's string and bumps that step's
         X-<Addon>-Forever-Version line in KitnUI.toc. A retail export never
         reaches Forever. -->
    <Script file="Forever\AddOns\EllesmereUI.lua" />
    <Script file="Forever\AddOns\Plater.lua" />
    <Script file="Forever\AddOns\BigWigs.lua" />
    <Script file="Forever\AddOns\NSRT.lua" />
    <Script file="Forever\AddOns\EditMode.lua" />
    <Script file="Forever\AddOns\KitnEssentials.lua" />
    <Script file="Forever\AddOns\BuffReminders.lua" />
    <Script file="Forever\AddOns\Baganator.lua" />

    <!-- Per-class data -->
    <Script file="Forever\Classes\BlizzardCDM.lua" />
</Ui>
