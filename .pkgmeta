package-as: KitnUI

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Only tracked files need listing here — gitignored paths (References/,
# dev/docs/, .claude/, .wow-api-reference, editor configs) never reach the
# packager's clone. Tracked dev-tree files (incl. dev/Annotations/) are
# stripped solely by the `- dev` entry below.
ignore:
  - .pkgmeta
  - .github
  - .gitattributes
  - .gitignore
  - .luacheckrc
  - dev
  - Legacy  # dormant v1 ElvUI installer
  - CHANGELOG.md
  - README.md
