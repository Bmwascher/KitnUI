#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════╗
# ║  dev/githooks/pre-push                                   ║
# ║  Local gate so bad code never reaches a pushed branch.   ║
# ╚══════════════════════════════════════════════════════════╝
#
# Opt in once (per clone / per worktree):
#     git config core.hooksPath dev/githooks
#   (dev/scripts/install-claude-hooks.ps1 sets this for you.)
#
# Requires luacheck on PATH. On Windows, ensure the luarocks bin dir (e.g.
# %APPDATA%\luarocks\bin) is on PATH — see dev/README.md. Override a single
# push with:  git push --no-verify
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

# Release-tag guard (blocking): a v* tag must point at the release commit —
# subject "vX.Y.Z: …" — and that commit must sit on main. Tagging a merge or
# feature commit instead breaks the family release convention (see ../AGENTS.md).
# Git feeds the pushed refs on stdin. Override with: git push --no-verify
while read -r _lref _lsha _rref _rsha; do
    case "$_rref" in refs/tags/v*) ;; *) continue ;; esac
    # skip tag deletions (local sha is all zeros)
    case "$_lsha" in *[!0]*) ;; *) continue ;; esac
    tag="${_rref#refs/tags/}"
    subject="$(git log -1 --format=%s "$_lsha" 2>/dev/null)"
    case "$subject" in
        "$tag:"*) ;;
        *)
            echo "[pre-push] BLOCKED: $tag points at '$subject' — tag the release commit ('$tag: …') instead, or override with: git push --no-verify" >&2
            exit 1
            ;;
    esac
    if ! git merge-base --is-ancestor "$_lsha" refs/heads/main 2>/dev/null; then
        echo "[pre-push] BLOCKED: $tag targets a commit not on main — merge to main first, then tag. Override: git push --no-verify" >&2
        exit 1
    fi
done

# Blocking: the luacheck warning baseline is zero. luacheck may ship as a
# luarocks .bat on Windows (Smart App Control blocks the standalone exe) —
# resolve both forms.
luacheck_bin="$(command -v luacheck || command -v luacheck.bat || true)"
echo "[pre-push] luacheck…"
if [ -n "$luacheck_bin" ]; then
    if ! "$luacheck_bin" . -q; then
        echo "[pre-push] BLOCKED: luacheck warnings. Fix them, or override with: git push --no-verify" >&2
        exit 1
    fi
else
    echo "[pre-push] luacheck not on PATH — skipping lint. (CI will still lint.)" >&2
fi

echo "[pre-push] OK"
