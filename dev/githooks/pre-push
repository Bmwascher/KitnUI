#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════╗
# ║  dev/githooks/pre-push                                   ║
# ║  Local gate so bad code never reaches a pushed branch.   ║
# ╚══════════════════════════════════════════════════════════╝
#
# Opt in once (per clone / per worktree):
#     git config core.hooksPath dev/githooks
#   (dev/scripts/install-claude-hooks.ps1 sets this for you.)
#
# Requires luacheck on PATH. On Windows, ensure the luarocks bin dir (e.g.
# %APPDATA%\luarocks\bin) is on PATH — see dev/README.md. Override a single
# push with:  git push --no-verify
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

# Buffer the pushed refs FIRST: git feeds one line per ref on stdin,
# consumable exactly once, and both the tag guard and the comment gate
# below need them (a second `while read` would see nothing).
pushed_refs=()
while IFS= read -r _line; do pushed_refs+=("$_line"); done

# Release-tag guard (blocking): a v* tag must point at the release commit —
# subject "vX.Y.Z: …" — and that commit must sit on main. Tagging a merge or
# feature commit instead breaks the family release convention (see ../AGENTS.md).
# Override with: git push --no-verify
for _line in "${pushed_refs[@]}"; do
    read -r _lref _lsha _rref _rsha <<< "$_line"
    case "$_rref" in refs/tags/v*) ;; *) continue ;; esac
    # skip tag deletions (local sha is all zeros)
    case "$_lsha" in *[!0]*) ;; *) continue ;; esac
    tag="${_rref#refs/tags/}"
    subject="$(git log -1 --format=%s "$_lsha" 2>/dev/null)"
    case "$subject" in
        "$tag:"*) ;;
        *)
            echo "[pre-push] BLOCKED: $tag points at '$subject' — tag the release commit ('$tag: …') instead, or override with: git push --no-verify" >&2
            exit 1
            ;;
    esac
    if ! git merge-base --is-ancestor "$_lsha" refs/heads/main 2>/dev/null; then
        echo "[pre-push] BLOCKED: $tag targets a commit not on main — merge to main first, then tag. Override: git push --no-verify" >&2
        exit 1
    fi
done

# Comment and message guards over everything this push would publish
# (blocking): the commit-time hooks are skippable with --no-verify, other
# tools commit without them at all, and a tag push carries commits of its own.
# Scanned one commit at a time, because a comment added in one commit and
# removed in a later one never appears in a range diff yet still publishes.
ng_lib="$repo_root/dev/githooks/lib/name-guards.sh"
if [ ! -f "$ng_lib" ]; then
    echo "[pre-push] BLOCKED: missing $ng_lib - the guards cannot run." >&2
    exit 1
fi
# shellcheck source=/dev/null
. "$ng_lib"
ng_load pre-push stems shorts compat provenance namesCI namesCS || exit 1

# git names the push destination in $1 and its location in $2. Query the
# location, since a remote whose pushurl differs from its fetch url would be
# answered by the wrong host; print the name, since an https location can
# carry credentials.
_dest="${2:-${1:-}}"
_dest_label="${1:-$_dest}"
# Pushing to a bare URL makes both arguments that URL, so there is no safe
# name to print.
case "$_dest_label" in *://*|*@*) _dest_label="the destination" ;; esac
_fallback=()
_fallback_ready=0

# What to subtract for a ref whose advertised sha this clone does not hold.
# Local tracking refs go stale when a branch is deleted or rewritten remotely,
# and a stale ref subtracts commits the remote never had, so ask the remote
# what it carries now. Only shas held locally can be subtracted, so the answer
# over-scans at worst, and a remote that cannot be reached subtracts nothing
# at all rather than falling back to the stale refs this exists to avoid.
# Computed once, and only when a ref needs it: it is a network round trip to
# the host this push is about to contact anyway.
ng_fallback_excl() {
    [ "$_fallback_ready" -eq 0 ] || return 0
    _fallback_ready=1
    local refs sha rest
    if ! refs="$(git ls-remote --heads --tags "$_dest" 2>/dev/null)"; then
        echo "[pre-push] $_dest_label did not answer — scanning the full history reachable from each ref." >&2
        return 0
    fi
    while read -r sha rest; do
        [ -n "$sha" ] || continue
        git cat-file -e "$sha^{commit}" 2>/dev/null && _fallback+=("$sha")
    done <<< "$refs"
}

for _line in "${pushed_refs[@]}"; do
    read -r _lref _lsha _rref _rsha <<< "$_line"
    # skip deletions (local sha is all zeros)
    case "$_lsha" in *[!0]*) ;; *) continue ;; esac
    # The advertised remote sha bounds the scan only when this clone holds
    # that object: force-pushing over an unfetched tip would otherwise make
    # every git call fail and read as a clean scan.
    _excl=()
    case "$_rsha" in
        *[!0]*) git cat-file -e "$_rsha^{commit}" 2>/dev/null && _excl=("$_rsha") ;;
    esac
    if [ "${#_excl[@]}" -eq 0 ]; then
        ng_fallback_excl
        _excl=(${_fallback[@]+"${_fallback[@]}"})
    fi
    if ! _new="$(git rev-list "$_lsha" --not ${_excl[@]+"${_excl[@]}"})"; then
        echo "[pre-push] BLOCKED: could not list the commits $_lref would publish." >&2
        exit 1
    fi
    [ -n "$_new" ] || continue
    _count="$(printf '%s\n' "$_new" | wc -l)"
    if [ "$_count" -gt 200 ]; then
        echo "[pre-push] scanning $_count commits for $_lref — this takes a moment." >&2
    fi
    for _c in $_new; do
        if ! _short="$(git rev-parse --short "$_c")" \
            || ! _comments="$(ng_commit_comments "$_c")" \
            || ! _msg="$(git log -1 --format='%s%n%b' "$_c")"; then
            echo "[pre-push] BLOCKED: could not read commit $_c." >&2
            exit 1
        fi
        if ! ng_scan_comments pre-push "comments added in commit $_short" "$_comments"; then
            echo "[pre-push] Fix the comments and amend or rebase, or override a deliberate exception with: git push --no-verify" >&2
            exit 1
        fi
        if ! ng_scan_text pre-push "commit $_short" "$_msg"; then
            echo "[pre-push] Reword it with an interactive rebase, or override a deliberate exception with: git push --no-verify" >&2
            exit 1
        fi
    done
done


# Blocking: the luacheck warning baseline is zero. luacheck may ship as a
# luarocks .bat on Windows (Smart App Control blocks the standalone exe) —
# resolve both forms.
luacheck_bin="$(command -v luacheck || command -v luacheck.bat || true)"
echo "[pre-push] luacheck…"
if [ -n "$luacheck_bin" ]; then
    if ! "$luacheck_bin" . -q; then
        echo "[pre-push] BLOCKED: luacheck warnings. Fix them, or override with: git push --no-verify" >&2
        exit 1
    fi
else
    echo "[pre-push] luacheck not on PATH — skipping lint. (CI will still lint.)" >&2
fi

echo "[pre-push] OK"
