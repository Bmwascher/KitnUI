# KitnUI — local-only files. Everything else is tracked; the shipped player zip
# is shaped by .pkgmeta (which strips dev/, Legacy/, README/CHANGELOG/.github/…),
# not this file. Non-shipped masters + planning docs live under dev/docs/.

# Claude Code / Codex workspace (config, skills, project instructions)
.claude/
.codex/
.agents/
References/
CLAUDE.md
AGENTS.md


# Editor settings & language-server config (machine-local). .luacheckrc is
# tracked (shared lint config, like KitnEssentials); .wowluarc.json is not.
.wowluarc.json
.vscode/
.idea/
.wow-api-reference


# Local-only dev docs: CurseForge readme, art masters, the References index, and
# planning / Superpowers artifacts. Tracked dev tooling (dev/Annotations/,
# dev/README.md) stays in git.
dev/docs/


# Icon variant sets. ONLY the loose icon-*.tga sitting directly in
# KitnUI_EUI/Media/TopBar/ ship, because that is the only place the addon looks:
# Elements.lua builds every path as ICON_DIR .. "icon-" .. id .. ".tga" and never
# reaches into a subfolder. Base/, Halo/ and Stencil/ are the three style trials
# the shipped set was picked from, 19 files each. Kept on disk so the choice can
# be revisited, out of git so the repo does not carry three unused copies of
# every icon.
KitnUI_EUI/Media/TopBar/Base/
KitnUI_EUI/Media/TopBar/Halo/
KitnUI_EUI/Media/TopBar/Stencil/
